# Copy this file to .env and fill in your own values. Never commit .env.
#
# MongoDB Atlas (recommended):
#   MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
# Local MongoDB Community Server:
#   MONGO_URI=mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=MarketMindDB

# Milliseconds to wait for the server before reporting a connection failure
MONGO_TIMEOUT_MS=5000

# Market used for the machine learning steps. The saved models were trained on
# the US market of the Global Superstore dataset, so keep this as US unless you
# retrain them.
ML_MARKET=US
